# Copy to .env and fill in. .env is git-ignored — never commit real keys,
# and never copy any of these into a VITE_* variable: Vite ships those to
# the browser, which would publish the secret.

# Google AI Studio key for the /api/chat endpoint.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

PORT=3001
