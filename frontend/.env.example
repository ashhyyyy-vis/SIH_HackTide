# ---------------------------------------------------------------
# Frontend configuration. Vite only exposes VITE_* to the browser,
# so NOTHING secret may live here. DB passwords, JWT secrets and
# Bhashini keys belong in SIH_HackTide/backend/.env (server-side).
# ---------------------------------------------------------------

# LEAVE THESE BLANK for normal development.
#
# Blank => the app calls relative paths (/api and /auth-api) and the Vite
# proxy in vite.config.js forwards them to :3001 and :5001. That is the
# only setup that works over a dev tunnel or from a phone on your LAN,
# because the browser only ever talks to the origin it loaded from.
#
# Set these ONLY when the backends are deployed on a different public
# origin than the frontend, e.g. VITE_API_BASE_URL=https://api.example.com
# Never point them at http://localhost from a tunnelled/HTTPS page.
VITE_API_BASE_URL=
VITE_AUTH_API_BASE_URL=
