# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sih_hackathon
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key_change_in_production

# Server Configuration
# 5001, not 5000: the frontend's Vite proxy forwards /auth-api to :5001,
# and on macOS port 5000 is taken by AirPlay Receiver.
PORT=5001
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# Defaults to the Vite dev server if unset.
CORS_ORIGIN=http://localhost:5173

# Bhashini API Configuration
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_API_KEY=your_ulca_api_key
BHASHINI_INFERENCE_API_KEY=your_inference_api_key
